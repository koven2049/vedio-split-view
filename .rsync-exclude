# rsync exclude rules for code deployment — edit freely
# one rule per line, # = comment
# reference: https://ss64.com/bash/rsync.html

# ── version control & IDE ────────────────────────────────────────────────────
.git/
.git
.DS_Store
.vscode/
.idea/
.claude/
.superpowers/
.code-review-graph/

# ── python cache / build ─────────────────────────────────────────────────────
backend/.venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/
.ruff_cache/

# ── frontend cache / build ───────────────────────────────────────────────────
frontend/node_modules
frontend/node_modules/
frontend/dist/

# ── test fixtures (large audio / video) ──────────────────────────────────────
test/
test_transcribe.py

# ── CI / tooling artefacts ───────────────────────────────────────────────────
.playwright-cli/
.mirror_state

# ── sensitive config (never overwrite remote secrets) ────────────────────────
# Deny by default: only the examples and build.cfg (remote rebuild reads it)
# are synced. Anything else in the remote config/ — secrets, KEK, the deploy
# stamp, operator backups like app.yaml.bak-* — is neither overwritten nor
# deleted by --delete. First matching rule wins, so keep these three first.
+ config/*.example
+ config/build.cfg
- config/*
config/app.yaml
config/deploy.cfg
config/certs/
config/*_cookies.txt
config/feishu.yaml
config/*.pem
config/*.key
# 部署盖章文件（deploy 成功后写入，唯一写入点；排除防 --delete 删掉已有章）
config/env

# ── runtime data & logs (never overwrite remote DB / logs) ───────────────────
data/
logs/

# ── remote-only rollback backups (docs/process-deploy-plan.md) ──────────────
*.container.bak

# ── this file itself (remote may have its own) ──────────────────────────────
.rsync-exclude

# perf bench artifacts (huashu-flash round, 2026-11)
perf/
