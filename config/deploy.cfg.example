# 部署配置 — 用于 manage.sh deploy
#
# 用法: cp config/deploy.cfg.example config/deploy.cfg
#       编辑后执行 ./manage.sh deploy

# 环境标识：production | test
# production 环境下，agent 不得主动修改数据，必须经用户 approve
env = production

# SSH 目标（用户@主机 或 ~/.ssh/config 别名）
ssh_target = root@aliyun-hk

# 远程部署路径（源码将同步到此目录）
remote_path = ai/vedio-split-view

# rsync 额外选项（可选）
# rsync_opts = -e "ssh -p 22"
