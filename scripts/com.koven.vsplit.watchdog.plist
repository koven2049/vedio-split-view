<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.koven.vsplit.watchdog</string>
    <key>ProgramArguments</key>
    <array>
        <string>__ROOT__/scripts/watchdog.sh</string>
    </array>
    <!-- No KeepAlive on purpose: the script exits in <1s, KeepAlive would
         respawn-flood it. StartInterval drives the 30s guard cadence; the
         web agent itself carries RunAtLoad + KeepAlive for crash-revival. -->
    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>30</integer>
    <key>StandardOutPath</key>
    <string>__ROOT__/logs/watchdog.log</string>
    <key>StandardErrorPath</key>
    <string>__ROOT__/logs/watchdog.log</string>
</dict>
</plist>
